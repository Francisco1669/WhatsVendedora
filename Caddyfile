:80 {
    encode gzip zstd

    handle /assets/* {
        reverse_proxy evolution-api:8080
    }

    redir /manager /manager/ 308
    redir /evolution-manager /manager/ 308
    redir /evolution-manager/ /manager/ 308

    handle /manager/* {
        reverse_proxy evolution-api:8080
    }

    redir /evoapi /evoapi/ 308
    handle_path /evoapi/* {
        reverse_proxy evolution-api:8080
    }

    @webhook path /webhooks/evolution*
    request_body @webhook {
        max_size 10MB
    }

    reverse_proxy whatsvendedora-api:3333 {
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 65s
            write_timeout 65s
        }
    }
}
