NODE_ENV=production
PORT=3333

# Dominio publico apontando para a VPS
PUBLIC_DOMAIN=app.seudominio.com.br
ACME_EMAIL=ops@seudominio.com.br

# Tunnel Cloudflare (homologacao sem dominio proprio)
# Gere em Zero Trust > Networks > Tunnels e use no compose com docker-compose.tunnel.yml
CLOUDFLARE_TUNNEL_TOKEN=

# Evolution
EVOLUTION_API_KEY=troque-por-chave-forte
EVOLUTION_GLOBAL_WEBHOOK_SECRET=troque-por-segredo-global
EVOLUTION_WEBHOOK_GLOBAL_ENABLED=true
EVOLUTION_SERVER_URL=https://app.seudominio.com.br
EVOLUTION_DATABASE_CONNECTION_URI=postgresql://evolution:troque-por-senha-forte@evolution-postgres:5432/evolution?schema=public

# Banco da aplicacao Node (schema separado no mesmo Postgres)
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DATABASE_URL=postgresql://evolution:troque-por-senha-forte@evolution-postgres:5432/evolution
POSTGRES_SCHEMA=whatsvendedora
POSTGRES_POOL_MAX=20

# Fila
WEBHOOK_QUEUE_REDIS_URL=redis://evolution-redis:6379/7
WEBHOOK_QUEUE_NAME=whatsvendedora-webhooks
WEBHOOK_QUEUE_CONCURRENCY=8

# Auth
AUTH_JWT_SECRET=troque-por-jwt-secret-forte-com-32+-chars
AUTH_JWT_EXPIRES_IN=12h
AUTH_BCRYPT_ROUNDS=12
OWNER_BOOTSTRAP_NAME=Mundo da Variedade
OWNER_BOOTSTRAP_EMAIL=admin@seudominio.com.br
OWNER_BOOTSTRAP_PASSWORD=troque-por-senha-forte

# Security
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=300

# Retencao
ENABLE_RETENTION_JOB=true
MESSAGE_RETENTION_DAYS=15

# S3/R2 (opcional)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL_PREFIX=
