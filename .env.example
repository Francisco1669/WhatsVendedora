PORT=3333
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_GLOBAL_WEBHOOK_SECRET=
# Quando a Evolution roda em container e o app roda no host Windows,
# use: http://host.docker.internal:3333
PUBLIC_WEBHOOK_BASE_URL=http://host.docker.internal:3333
# URL global opcional usada pelo docker-compose da Evolution.
EVOLUTION_WEBHOOK_GLOBAL_URL=http://host.docker.internal:3333/webhooks/evolution
DB_PATH=./data/multi-instance.db

AUTH_JWT_EXPIRES_IN=12h
AUTH_BCRYPT_ROUNDS=10
OWNER_BOOTSTRAP_NAME=Dona

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# JWT secret (required) - set a strong value before running in production
AUTH_JWT_SECRET=oii

OWNER_BOOTSTRAP_EMAIL=teste@empresa.com
OWNER_BOOTSTRAP_PASSWORD=password
