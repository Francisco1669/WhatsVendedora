PORT=3333
NODE_ENV=development

# Evolution API v2 no mesmo docker-compose.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_GLOBAL_WEBHOOK_SECRET=
EVOLUTION_MANAGER_URL=http://evolution-api:8080/manager

# URL interna do backend para receber webhooks dentro do compose.
PUBLIC_WEBHOOK_BASE_URL=http://whatsvendedora-api:3333

# Usado apenas se voce subir a Evolution local pelo docker-compose.evolution.yml.
EVOLUTION_WEBHOOK_GLOBAL_URL=http://whatsvendedora-api:3333/webhooks/evolution
EVOLUTION_WEBHOOK_GLOBAL_ENABLED=true

# Tunnel Cloudflare (opcional para expor local/VPS sem dominio proprio)
CLOUDFLARE_TUNNEL_TOKEN=

# Banco da aplicacao Node no PostgreSQL do compose.
POSTGRES_DATABASE_URL=postgresql://evolution:evolution@evolution-postgres:5432/evolution
POSTGRES_SCHEMA=whatsvendedora
POSTGRES_POOL_MAX=10

# Fila de webhooks no Redis do compose.
WEBHOOK_QUEUE_REDIS_URL=redis://evolution-redis:6379/7
WEBHOOK_QUEUE_NAME=whatsvendedora-webhooks
WEBHOOK_QUEUE_CONCURRENCY=5

AUTH_JWT_EXPIRES_IN=12h
AUTH_BCRYPT_ROUNDS=10
AUTH_DEFAULT_TENANT_SLUG=tenant_default
MULTI_TENANT_ENFORCED=false
CORS_ALLOWED_ORIGINS=http://localhost:3333
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=300
ENABLE_RETENTION_JOB=true
MESSAGE_RETENTION_DAYS=15

# S3 Media Upload (Optional) - Cloudflare R2, AWS S3, MinIO
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL_PREFIX=

OWNER_BOOTSTRAP_NAME=Dona

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# JWT secret (required) - set a strong value before running in production
AUTH_JWT_SECRET=change-this-to-a-strong-random-secret

OWNER_BOOTSTRAP_EMAIL=teste@empresa.com
OWNER_BOOTSTRAP_PASSWORD=change-this-password
