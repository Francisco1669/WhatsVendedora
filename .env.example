PORT=3333

# EvoAPI Cloud / Evolution API v2.
# Para evoapicloud, use a URL base informada no painel e a API key do projeto/instancia.
EVOAPICLOUD_API_URL=https://your-evoapicloud-server-url
EVOAPICLOUD_API_KEY=change-me
EVOAPICLOUD_GLOBAL_WEBHOOK_SECRET=
EVOAPICLOUD_MANAGER_URL=https://app.evoapicloud.com

# Aliases antigos ainda sao aceitos pelo app:
# EVOLUTION_API_URL=http://127.0.0.1:8080
# EVOLUTION_API_KEY=change-me
# EVOLUTION_GLOBAL_WEBHOOK_SECRET=

# URL publica do backend para receber webhooks.
# Em producao/cloud, precisa ser HTTPS publico.
# Em Windows + Docker Desktop local, use: http://host.docker.internal:3333
PUBLIC_WEBHOOK_BASE_URL=https://your-public-backend-url

# Usado apenas se voce subir a Evolution local pelo docker-compose.evolution.yml.
EVOLUTION_WEBHOOK_GLOBAL_URL=http://host.docker.internal:3333/webhooks/evolution
EVOLUTION_WEBHOOK_GLOBAL_ENABLED=true
DB_PATH=./data/multi-instance.db

AUTH_JWT_EXPIRES_IN=12h
AUTH_BCRYPT_ROUNDS=10
OWNER_BOOTSTRAP_NAME=Dona

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# JWT secret (required) - set a strong value before running in production
AUTH_JWT_SECRET=oii

OWNER_BOOTSTRAP_EMAIL=teste@empresa.com
OWNER_BOOTSTRAP_PASSWORD=password
